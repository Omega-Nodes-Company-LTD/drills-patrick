# ----------------------------------------------------------------------------
# Required
# ----------------------------------------------------------------------------
# PostgreSQL 18 with the `vector` extension available.
DATABASE_URL="postgres://postgres:postgres@localhost:5433/pozzi"
# Public origin of the deployment (no trailing slash). Used for callbacks,
# canonical URLs, sitemaps and payment redirects.
APP_URL="http://localhost:3000"
# Secret used to sign session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-with-a-long-random-string"

# ----------------------------------------------------------------------------
# Object storage (Hetzner S3-compatible) — media library
# Without these the media library is disabled, everything else keeps working.
# ----------------------------------------------------------------------------
S3_ENDPOINT="https://fsn1.your-objectstorage.com"
S3_REGION="fsn1"
S3_BUCKET="shared-bucket"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Folder inside the shared bucket reserved for this site. Keep the trailing
# slash out; it is normalised automatically.
S3_PREFIX="pozzi-patrick"
# Public base URL used to build image URLs. Defaults to
# `${S3_ENDPOINT}/${S3_BUCKET}` when omitted. Set it to a CDN domain if present.
S3_PUBLIC_BASE_URL=""
# Hetzner works with path-style addressing.
S3_FORCE_PATH_STYLE="true"

# ----------------------------------------------------------------------------
# Payment providers — every one of them is optional.
# A provider only shows up in the donation form when fully configured.
# Bank transfer is always available and is configured from the admin settings.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# sandbox | live
PAYPAL_ENV="sandbox"

PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
# sandbox | live
PESAPAL_ENV="sandbox"

MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
# sandbox | live
MTN_MOMO_ENV="sandbox"
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"

AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
# sandbox | live
AIRTEL_ENV="sandbox"
AIRTEL_COUNTRY="UG"
AIRTEL_CURRENCY="UGX"

# ----------------------------------------------------------------------------
# Embeddings & RAG assistant — optional.
# Without EMBEDDINGS_API_KEY search falls back to full-text and the chat
# assistant is not rendered.
# ----------------------------------------------------------------------------
EMBEDDINGS_API_KEY=""
EMBEDDINGS_BASE_URL="https://openrouter.ai/api/v1"
EMBEDDINGS_MODEL="openai/text-embedding-3-small"
# Must match the vector dimension of the migration (default 1536).
EMBEDDINGS_DIM="1536"
# Chat model used by the RAG assistant (OpenRouter chat completions).
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
RAG_CHAT_MODEL="anthropic/claude-3.5-haiku"

# ----------------------------------------------------------------------------
# Email (receipts and notifications) — optional
# ----------------------------------------------------------------------------
SMTP_URL=""
MAIL_FROM="Patrick Wells <no-reply@example.com>"

# ----------------------------------------------------------------------------
# Scheduled jobs — protects /api/cron/* endpoints. Generate a random string.
# ----------------------------------------------------------------------------
CRON_SECRET=""
